#!/bin/sh

case "$1" in

list)

cat <<EOF
{
 "dashboard": {
  "read": true
 }
}
EOF

;;

call)

case "$2" in

read)

echo "{"

echo '"uptime":"'
uptime | cut -d',' -f1
echo '",'

echo '"load":"'
cat /proc/loadavg | cut -d' ' -f1-3
echo '",'

echo '"memory":"'
free | awk '/Mem/ {print $3 "/" $2}'
echo '",'

echo '"ath11k_nss":"'
cat /sys/module/ath11k/parameters/nss_offload 2>/dev/null
echo '",'

echo '"wifi_irqs":"'
grep ath11k /proc/interrupts | wc -l
echo '",'

echo '"wifi_channels":"'
iwinfo 2>/dev/null | grep Channel | head -1
echo '",'

echo '"ecm_ipv4":"'
cat /sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count 2>/dev/null
echo '",'

echo '"nss_modules":"'
lsmod | grep qca_nss | wc -l
echo '"'

echo "}"

;;

esac

;;

esac
