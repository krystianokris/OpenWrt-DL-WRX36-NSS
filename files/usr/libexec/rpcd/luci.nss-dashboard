#!/bin/sh

value() {
        printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

num_file() {
        [ -r "$1" ] && cat "$1" 2>/dev/null || printf '0'
}

case "$1" in
list)
        cat <<'JSON'
{"read":{}}
JSON
        ;;

call)
        case "$2" in
        read)

                load="$(cut -d ' ' -f 1-3 /proc/loadavg 2>/dev/null)"

                set -- $(awk '
                /MemTotal:/ { total=$2 }
                /MemAvailable:/ { available=$2 }
                END {
                        printf "%d %d", (total-available)/1024, total/1024
                }' /proc/meminfo)

                memory="${1:-0} MiB / ${2:-0} MiB"

                uptime="$(uptime 2>/dev/null | sed 's/.* up[[:space:]]*//; s/,.*//')"

                build="$( [ -r /etc/dl-wrx36-nss-build ] && cat /etc/dl-wrx36-nss-build 2>/dev/null || printf '0' )"

                ath11k="$(cat /sys/module/ath11k/parameters/nss_offload 2>/dev/null)"
                [ "$ath11k" = "1" ] && ath11k="Enabled" || ath11k="Disabled"

                ipv4="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count)"
                tcp="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv4/tcp_accelerated_count)"
                udp="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv4/udp_accelerated_count)"
                pending="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv4/pending_accel_count)"

                ipv6="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv6/accelerated_count)"
                tcp6="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv6/tcp_accelerated_count)"
                udp6="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv6/udp_accelerated_count)"
                pending6="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv6/pending_accel_count)"
                pending_decel="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv4/pending_decel_count)"
                pending_decel6="$(num_file /sys/kernel/debug/ecm/ecm_nss_ipv6/pending_decel_count)"

                exceptions4="$(num_file /sys/kernel/debug/ecm/stats/ecm_v4_exception_stats)"
                exceptions6="$(num_file /sys/kernel/debug/ecm/stats/ecm_v6_exception_stats)"

                iface_state() {
                        ip link show "$1" 2>/dev/null |
                                grep -q 'state UP' && printf 'UP' || printf 'DOWN'
                }

                lan1="$(iface_state lan1)"
                lan2="$(iface_state lan2)"
                lan3="$(iface_state lan3)"
                lan4="$(iface_state lan4)"
                brlan="$(iface_state br-lan)"
                phy0="$(iface_state phy0-ap0)"
                phy1="$(iface_state phy1-ap0)"

                connections="$(num_file /sys/kernel/debug/ecm/ecm_db/connection_count)"
                hosts="$(num_file /sys/kernel/debug/ecm/ecm_db/host_count)"
                ifaces="$(num_file /sys/kernel/debug/ecm/ecm_db/iface_count)"
                mappings="$(num_file /sys/kernel/debug/ecm/ecm_db/mapping_count)"
                nodes="$(num_file /sys/kernel/debug/ecm/ecm_db/node_count)"

                modules="$(/sbin/lsmod 2>/dev/null | awk '$1 ~ /^qca_nss/ { count++ } END { print count+0 }')"

                temp="$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)"
                if [ -n "$temp" ]; then
                        temp="$((temp / 1000))°C"
                else
                        temp="Unavailable"
                fi

                qdisc="$(/sbin/lsmod 2>/dev/null | grep -q qca_nss_qdisc && printf 'Enabled' || printf 'Disabled')"

                cpu_freq="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)"
                if [ -n "$cpu_freq" ]; then
                        cpu_freq="$((cpu_freq / 1000)) MHz"
                else
                        cpu_freq="Unknown"
                fi

                wifi="$(iwinfo 2>/dev/null | awk '/Channel:/ {
                        sub(/^.*Channel: /,"");
                        sub(/ \|.*$/,"");
                        print;
                        exit
                }')"

                [ -n "$wifi" ] || wifi="Unavailable"

                irqs="$(awk '/ath11k|wlan|wifi/ { count++ } END { print count+0 }' /proc/interrupts 2>/dev/null)"

                # WAN / PPPoE
                wan_link="$(ip link show wan 2>/dev/null | grep -q 'state UP' && printf 'UP' || printf 'DOWN')"

                pppoe_link="$(ip -4 addr show dev pppoe-wan 2>/dev/null | grep -q 'inet ' && printf 'Connected' || printf 'Disconnected')"

                wan_ipv4="$(ip -4 addr show dev pppoe-wan 2>/dev/null | awk '/inet / {print $2; exit}')"
                [ -n "$wan_ipv4" ] || wan_ipv4="Unavailable"

                wan_ipv6="$(ip -6 addr show dev pppoe-wan scope global 2>/dev/null | awk '/inet6 / {print $2; exit}')"
                [ -n "$wan_ipv6" ] || wan_ipv6="Unavailable"

                vlan="$(ip link show wan.911 2>/dev/null | grep -q 'wan.911' && printf 'wan.911' || printf 'Unavailable')"

                # Health
                nss_drv="$(/sbin/lsmod 2>/dev/null | grep -q '^qca_nss_drv ' && printf 'OK' || printf 'ERROR')"
                nss_dp="$(/sbin/lsmod 2>/dev/null | grep -q '^qca_nss_dp ' && printf 'OK' || printf 'ERROR')"
                ecm_state="$( [ -r /sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count ] && printf 'OK' || printf 'ERROR' )"
                ath11k_health="$ath11k"
                qdisc_health="$qdisc"

                if [ "$nss_drv" = "OK" ] &&
                   [ "$nss_dp" = "OK" ] &&
                   [ "$ecm_state" = "OK" ] &&
                   [ "$ath11k_health" = "Enabled" ] &&
                   [ "$qdisc_health" = "Enabled" ]; then
                        health="OK"
                else
                        health="WARNING"
                fi

                # BATMAN-adv Mesh
                mesh_status="Inactive"
                mesh_iface="Unavailable"
                mesh_mac="Unavailable"
                mesh_gateway="Unavailable"
                mesh_originators="0"
                mesh_neighbors="0"

                batman_v="Disabled"
                batman_bla="Disabled"
                batman_dat="Disabled"
                batman_mcast="Disabled"

                usteer_status="Inactive"

                if command -v pidof >/dev/null 2>&1 &&
                   pidof usteerd >/dev/null 2>&1; then
                        usteer_status="Active"
                elif [ -x /etc/init.d/usteer ] &&
                     /etc/init.d/usteer status >/dev/null 2>&1; then
                        usteer_status="Active"
                fi

                if ip link show bat0 >/dev/null 2>&1; then
                        mesh_iface="bat0"

                        mesh_mac="$(cat /sys/class/net/bat0/address 2>/dev/null)"
                        [ -n "$mesh_mac" ] || mesh_mac="Unavailable"

                        if ip link show bat0 2>/dev/null | grep -q 'state UP'; then
                                mesh_status="Active"
                        else
                                mesh_status="Down"
                        fi

                        if command -v batctl >/dev/null 2>&1; then
                                mesh_gateway="$(batctl gw 2>/dev/null |
                                        awk '/=>/ {print $1 " " $2; exit}')"
                                [ -n "$mesh_gateway" ] || mesh_gateway="None"

                                mesh_originators="$(batctl o 2>/dev/null |
                                        awk 'NR > 1 && NF {count++} END {print count+0}')"

                                mesh_neighbors="$(batctl n 2>/dev/null |
                                        awk 'NR > 1 && NF {count++} END {print count+0}')"

                                batman_v="$(batctl meshif bat0 get hop_penalty 2>/dev/null >/dev/null && printf 'Enabled' || printf 'Disabled')"

                                batman_bla="$(batctl meshif bat0 get bridge_loop_avoidance 2>/dev/null |
                                        grep -q 'enabled' && printf 'Enabled' || printf 'Disabled')"

                                batman_dat="$(batctl meshif bat0 get distributed_arp_table 2>/dev/null |
                                        grep -q 'enabled' && printf 'Enabled' || printf 'Disabled')"

                                batman_mcast="$(batctl meshif bat0 get multicast_mode 2>/dev/null |
                                        grep -qv '^disabled' && printf 'Enabled' || printf 'Disabled')"
                        fi
                fi

                printf '{"cpu_load":"%s","memory":"%s","uptime":"%s","build":"%s","ath11k_nss":"%s","nss_modules":"%s","ecm_ipv4":"%s","ecm_tcp":"%s","ecm_udp":"%s","ecm_pending":"%s","ecm_ipv6":"%s","ecm_tcp6":"%s","ecm_udp6":"%s","ecm_pending6":"%s","ecm_pending_decel":"%s","ecm_pending_decel6":"%s","ecm_exceptions4":"%s","ecm_exceptions6":"%s","ecm_connections":"%s","ecm_hosts":"%s","ecm_ifaces":"%s","ecm_mappings":"%s","ecm_nodes":"%s","lan1":"%s","lan2":"%s","lan3":"%s","lan4":"%s","br_lan":"%s","phy0":"%s","phy1":"%s","wifi_channel":"%s","wifi_irqs":"%s","temperature":"%s","qdisc":"%s","cpu_freq":"%s","wan_link":"%s","pppoe_status":"%s","wan_ipv4":"%s","wan_ipv6":"%s","wan_vlan":"%s","health":"%s","nss_drv":"%s","nss_dp":"%s","ecm_health":"%s","mesh_status":"%s","mesh_iface":"%s","mesh_mac":"%s","mesh_gateway":"%s","mesh_originators":"%s","mesh_neighbors":"%s","batman_v":"%s","batman_bla":"%s","batman_dat":"%s","batman_mcast":"%s","usteer_status":"%s"}\n' \
                "$(value "$load")" \
                "$(value "$memory")" \
                "$(value "$uptime")" \
                "$(value "$build")" \
                "$(value "$ath11k")" \
                "$modules" \
                "$ipv4" \
                "$tcp" \
                "$udp" \
                "$pending" \
                "$ipv6" \
                "$tcp6" \
                "$udp6" \
                "$pending6" \
                "$pending_decel" \
                "$pending_decel6" \
                "$(value "$exceptions4")" \
                "$(value "$exceptions6")" \
                "$connections" \
                "$hosts" \
                "$ifaces" \
                "$mappings" \
                "$nodes" \
                "$lan1" \
                "$lan2" \
                "$lan3" \
                "$lan4" \
                "$brlan" \
                "$phy0" \
                "$phy1" \
                "$(value "$wifi")" \
                "$irqs" \
                "$(value "$temp")" \
                "$qdisc" \
                "$(value "$cpu_freq")" \
                "$wan_link" \
                "$pppoe_link" \
                "$(value "$wan_ipv4")" \
                "$(value "$wan_ipv6")" \
                "$wan_rx" \
                "$wan_tx" \
                "$vlan" \
                "$health" \
                "$nss_drv" \
                "$nss_dp" \
                "$ecm_state" \
                "$(value "$mesh_status")" \
                "$(value "$mesh_iface")" \
                "$(value "$mesh_mac")" \
                "$(value "$mesh_gateway")" \
                "$mesh_originators" \
                "$mesh_neighbors" \
                "$(value "$batman_v")" \
                "$(value "$batman_bla")" \
                "$(value "$batman_dat")" \
                "$(value "$batman_mcast")" \
                "$(value "$usteer_status")"

        ;;
        esac
        ;;

esac
