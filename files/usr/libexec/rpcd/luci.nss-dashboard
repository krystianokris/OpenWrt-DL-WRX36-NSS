#!/bin/sh

value() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

read_file() {
	[ -r "$1" ] && cat "$1" 2>/dev/null || printf '0'
}

case "$1" in
list)
	cat <<'JSON'
{"read":{}}
JSON
	;;

call)
	case "$2" in

	read)

		load="$(cut -d ' ' -f 1-3 /proc/loadavg 2>/dev/null)"

		set -- $(awk '
		/MemTotal:/ { total=$2 }
		/MemAvailable:/ { available=$2 }
		END {
			printf "%d %d", (total-available)/1024, total/1024
		}' /proc/meminfo)

		memory="${1:-0} MiB / ${2:-0} MiB"

		uptime="$(uptime 2>/dev/null | sed 's/.* up[[:space:]]*//; s/,.*//')"

		build="$(read_file /etc/dl-wrx36-nss-build)"

		ath11k="$(read_file /sys/module/ath11k/parameters/nss_offload)"
		[ "$ath11k" = "1" ] && ath11k="Enabled" || ath11k="Disabled"

		ipv4="$(read_file /sys/kernel/debug/ecm/ecm_nss_ipv4/accelerated_count)"
		tcp="$(read_file /sys/kernel/debug/ecm/ecm_nss_ipv4/tcp_accelerated_count)"
		udp="$(read_file /sys/kernel/debug/ecm/ecm_nss_ipv4/udp_accelerated_count)"
		pending="$(read_file /sys/kernel/debug/ecm/ecm_nss_ipv4/pending_accel_count)"

		modules="$(lsmod 2>/dev/null | awk '$1 ~ /^qca_nss/ { count++ } END { print count+0 }')"

		temp="$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)"
		if [ -n "$temp" ]; then
			temp="$((temp / 1000))°C"
		else
			temp="Unavailable"
		fi

		qdisc="$(lsmod 2>/dev/null | grep -q qca_nss_qdisc && printf 'Enabled' || printf 'Disabled')"

		cpu_freq="$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq 2>/dev/null)"
		if [ -n "$cpu_freq" ]; then
			cpu_freq="$((cpu_freq / 1000)) MHz"
		else
			cpu_freq="Unknown"
		fi

		wifi="$(iwinfo 2>/dev/null | awk '/Channel:/ {
			sub(/^.*Channel: /,"");
			sub(/ \|.*$/,"");
			print;
			exit
		}')"

		[ -n "$wifi" ] || wifi="Unavailable"

		irqs="$(awk '/ath11k|wlan|wifi/ { count++ } END { print count+0 }' /proc/interrupts 2>/dev/null)"

		printf '{"cpu_load":"%s","memory":"%s","uptime":"%s","build":"%s","ath11k_nss":"%s","nss_modules":"%s","ecm_ipv4":"%s","ecm_tcp":"%s","ecm_udp":"%s","ecm_total":"%s","ecm_pending":"%s","wifi_channel":"%s","wifi_irqs":"%s","temperature":"%s","qdisc":"%s","cpu_freq":"%s"}\n' \
		"$(value "$load")" \
		"$(value "$memory")" \
		"$(value "$uptime")" \
		"$(value "$build")" \
		"$(value "$ath11k")" \
		"$modules" \
		"$ipv4" \
		"$tcp" \
		"$udp" \
		"$ipv4" \
		"$pending" \
		"$(value "$wifi")" \
		"$irqs" \
		"$(value "$temp")" \
		"$qdisc" \
		"$(value "$cpu_freq")"

	;;

	esac
	;;

esac
